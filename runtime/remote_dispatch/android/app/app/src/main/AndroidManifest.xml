<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Overlay indicator banner -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Kill-action notification (API 33+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Screen capture: MediaProjection must be held by a foreground
         service with the mediaProjection type on API 29+ -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

    <application
        android:label="REMOR Dispatch Target"
        android:allowBackup="false">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".DispatchAccessibilityService"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Owns the MediaProjection capture pipeline for the session
             stream. Holds no session state and performs no
             authorization; the kill latch is enforced in BridgeServer
             before capture_frame is dispatched. -->
        <service
            android:name=".CaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- Hosts the remote-dispatch TLS TargetServer on 0.0.0.0 so
             the paired controller on the LAN can reach it. -->
        <service
            android:name=".RemoteListener"
            android:exported="false" />

        <activity
            android:name=".ConsentActivity"
            android:exported="false" />

        <!-- RD-EASYPAIR-1: tap-to-pair consent screen. -->
        <activity
            android:name=".PairConsentActivity"
            android:exported="false" />

    </application>
</manifest>
